---
import type { Registrar } from "../lib/registrars";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import PricingTable from "./PricingTable.astro";

interface Props {
  current: Registrar;
  allRegistrars: Registrar[];
  isAverage: boolean;
}

const { current, allRegistrars, isAverage } = Astro.props;

const displayName = isAverage ? "Average" : current.name;
const csvHref = `/database/${current.id}.csv`;
---

<SiteHeader current={current} allRegistrars={allRegistrars} />

<main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
  <section class="mb-6 sm:mb-8 flex flex-col gap-3">
    <h1 class="text-2xl sm:text-3xl font-bold">
      {isAverage ? (
        <><span class="text-primary">Average</span> Domain Pricing</>
      ) : (
        <><span class="text-primary">{displayName}</span> Domain Pricing</>
      )}
    </h1>
    <p class="text-base-content/70 max-w-prose">
      {isAverage ? (
        <>This page lists current average domain prices. Data is refreshed regularly.</>
      ) : (
        <>This page lists current {displayName} domain prices. Data is refreshed regularly.</>
      )}
    </p>

    <div class="flex flex-col gap-1">
      <span class="text-xs uppercase tracking-wide text-base-content/50">CSV database for developers</span>
      <a href={csvHref} class="font-mono text-sm badge badge-lg badge-outline h-auto py-2 px-3 w-fit break-all">
        https://domainpricing.net{csvHref}
      </a>
    </div>
  </section>

  <PricingTable rows={current.rows} />
</main>

<SiteFooter />
