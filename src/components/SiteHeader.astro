---
import type { Registrar } from "../lib/registrars";

interface Props {
  current: Registrar;
  allRegistrars: Registrar[];
}

const { current, allRegistrars } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <span class="brand-mark">$</span>
      <span class="brand-text">Domain<span class="brand-accent">Pricing</span></span>
    </a>

    <div class="header-controls">
      <label class="currency-label" for="currency-select">
        Currency
        <span class="info-dot" tabindex="0" aria-label="Currency conversion note">
          i
          <span class="tooltip" role="tooltip">
            Source data is denominated in USD and converted live using the
            Frankfurter exchange rate API.
          </span>
        </span>
      </label>
      <select id="currency-select" class="currency-select">
        <option value="USD">USD</option>
      </select>
    </div>
  </div>

  <script>
    import {
      populateCurrencyOptions,
      getRates,
      getSavedCurrency,
      saveCurrency,
    } from "../scripts/currency";

    const select = document.getElementById("currency-select") as HTMLSelectElement;

    async function init() {
      await populateCurrencyOptions(select);
      select.value = getSavedCurrency();
    }

    select.addEventListener("change", async () => {
      const currency = select.value;
      saveCurrency(currency);

      let rates = null;
      if (currency !== "USD") {
        rates = await getRates();
      }

      window.dispatchEvent(
        new CustomEvent("dp:currency-change", { detail: { currency, rates } })
      );
    });

    init();
  </script>

  <nav class="registrar-nav" aria-label="Registrars">
    <div class="wrap nav-scroll">
      <a
        href="/"
        class:list={["nav-pill", { active: current.id === "average" }]}
      >
        Average
      </a>
      {
        allRegistrars
          .filter((r) => r.id !== "average")
          .map((r) => (
            <a
              href={`/${r.slug}`}
              class:list={["nav-pill", { active: r.slug === current.slug }]}
            >
              {r.name}
            </a>
          ))
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 16px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text);
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 1.1rem;
    border: 1.5px solid var(--accent);
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .brand-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .brand-accent {
    color: var(--accent);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .currency-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .info-dot {
    position: relative;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid var(--text-faint);
    color: var(--text-faint);
    font-size: 10px;
    font-style: italic;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: help;
    font-family: var(--font-display);
  }

  .tooltip {
    display: none;
    position: absolute;
    top: 130%;
    right: -8px;
    width: 220px;
    background: var(--text);
    color: var(--bg);
    padding: 8px 10px;
    border-radius: var(--radius);
    font-size: 0.72rem;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
    z-index: 20;
    font-family: var(--font-body);
  }

  .info-dot:hover .tooltip,
  .info-dot:focus-visible .tooltip {
    display: block;
  }

  .currency-select {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 6px 10px;
    cursor: pointer;
  }

  .registrar-nav {
    background: var(--bg);
  }

  .nav-scroll {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-top: 10px;
    padding-bottom: 10px;
    scrollbar-width: thin;
  }

  .nav-pill {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 5px 10px;
    border-radius: var(--radius);
    color: var(--text-muted);
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .nav-pill:hover {
    background: var(--bg-hover);
    text-decoration: none;
    color: var(--text);
  }

  .nav-pill.active {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
