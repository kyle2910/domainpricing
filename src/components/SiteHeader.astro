---
import type { Registrar } from "../lib/registrars";

interface Props {
  current: Registrar;
  allRegistrars: Registrar[];
}

const { current, allRegistrars } = Astro.props;
---

<header class="border-b border-base-300 bg-base-100">
  <div class="navbar max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost text-lg font-semibold px-2">
        <span
          class="flex items-center justify-center w-6 h-6 rounded-full border border-primary text-primary text-sm font-mono"
          >$</span
        >
        Domain<span class="text-primary">Pricing</span>
      </a>
    </div>

    <div class="flex-none flex items-center gap-2">
      <div class="tooltip tooltip-bottom" data-tip="Source data is in USD, converted live via the Frankfurter exchange rate API.">
        <span class="hidden sm:inline text-xs uppercase tracking-wide text-base-content/60 mr-1">Currency</span>
      </div>
      <select id="currency-select" class="select select-bordered select-sm font-mono w-45">
        <option value="USD">USD</option>
      </select>
    </div>
  </div>

  <script>
    import {
      populateCurrencyOptions,
      getRates,
      getSavedCurrency,
      saveCurrency,
    } from "../scripts/currency";

    const select = document.getElementById("currency-select") as HTMLSelectElement;

    async function init() {
      await populateCurrencyOptions(select);
      select.value = getSavedCurrency();
    }

    select.addEventListener("change", async () => {
      const currency = select.value;
      saveCurrency(currency);

      let rates = null;
      if (currency !== "USD") {
        rates = await getRates();
      }

      window.dispatchEvent(
        new CustomEvent("dp:currency-change", { detail: { currency, rates } })
      );
    });

    init();
  </script>

  <nav aria-label="Registrars" class="border-t border-base-200 bg-base-200/40">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-2 flex gap-2 overflow-x-auto">
      <a
        href="/"
        class={`btn btn-xs sm:btn-sm font-mono ${current.id === "average" ? "btn-primary" : "btn-ghost"}`}
      >
        Average
      </a>
      {
        allRegistrars
          .filter((r) => r.id !== "average")
          .map((r) => (
            <a
              href={`/${r.slug}`}
              class={`btn btn-xs sm:btn-sm font-mono whitespace-nowrap ${r.slug === current.slug ? "btn-primary" : "btn-ghost"}`}
            >
              {r.name}
            </a>
          ))
      }
    </div>
  </nav>
</header>
