---
import type { TldRow } from "../lib/registrars";

interface Props {
  rows: TldRow[];
}

const { rows } = Astro.props;
---

<div class="card bg-base-100 border border-base-300 shadow-sm">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 border-b border-base-300">
    <label class="input input-bordered input-sm flex items-center gap-2 w-full sm:max-w-xs">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 opacity-50" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="tld-search"
        type="text"
        placeholder="Search TLDs (e.g., com, io, ai)"
        autocomplete="off"
        spellcheck="false"
        class="grow"
      />
    </label>
    <span id="row-count" class="text-xs font-mono text-base-content/50 whitespace-nowrap" aria-live="polite"></span>
  </div>

  <div class="overflow-x-auto">
    <table id="pricing-table" class="table table-zebra table-sm sm:table-md">
      <thead>
        <tr>
          <th data-key="tld" data-dir="asc" tabindex="0" role="button" class="cursor-pointer select-none hover:bg-base-200">
            TLD <span class="sort-arrow opacity-50">↕</span>
          </th>
          <th data-key="registration" data-dir="none" tabindex="0" role="button" class="cursor-pointer select-none hover:bg-base-200 text-right">
            Registration <span class="sort-arrow opacity-50">↕</span>
          </th>
          <th data-key="renewal" data-dir="none" tabindex="0" role="button" class="cursor-pointer select-none hover:bg-base-200 text-right">
            Renewal <span class="sort-arrow opacity-50">↕</span>
          </th>
        </tr>
      </thead>
      <tbody id="pricing-tbody">
        {
          rows.map((r) => (
            <tr data-tld={r.tld} data-registration={r.registration} data-renewal={r.renewal}>
              <td class="font-mono">.{r.tld}</td>
              <td class="font-mono text-right tabular-nums" data-field="registration">
                {r.registration.toFixed(2)}
              </td>
              <td class="font-mono text-right tabular-nums" data-field="renewal">
                {r.renewal.toFixed(2)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p id="no-results" class="text-center py-8 text-sm text-base-content/50" hidden>No TLDs match your search.</p>
  </div>
</div>

<script>
  import { getRates, getSavedCurrency, formatAmount, type RatesPayload } from "../scripts/currency";

  const table = document.getElementById("pricing-table") as HTMLTableElement;
  const tbody = document.getElementById("pricing-tbody") as HTMLTableSectionElement;
  const searchInput = document.getElementById("tld-search") as HTMLInputElement;
  const rowCountEl = document.getElementById("row-count") as HTMLElement;
  const noResultsEl = document.getElementById("no-results") as HTMLElement;
  const headers = Array.from(table.querySelectorAll("th[data-key]")) as HTMLTableCellElement[];

  let currentRates: RatesPayload | null = null;
  let currentCurrency = getSavedCurrency();

  type SortKey = "tld" | "registration" | "renewal";
  type SortDir = "asc" | "desc";
  let sortKey: SortKey = "tld";
  let sortDir: SortDir = "asc";

  function getRows(): HTMLTableRowElement[] {
    return Array.from(tbody.querySelectorAll("tr"));
  }

  function applySort() {
    const rows = getRows();
    rows.sort((a, b) => {
      let av: string | number;
      let bv: string | number;

      if (sortKey === "tld") {
        av = a.dataset.tld ?? "";
        bv = b.dataset.tld ?? "";
        const cmp = (av as string).localeCompare(bv as string);
        return sortDir === "asc" ? cmp : -cmp;
      }

      av = parseFloat(a.dataset[sortKey] ?? "0");
      bv = parseFloat(b.dataset[sortKey] ?? "0");
      const cmp = av - bv;
      return sortDir === "asc" ? cmp : -cmp;
    });

    rows.forEach((r) => tbody.appendChild(r));

    headers.forEach((h) => {
      const arrow = h.querySelector(".sort-arrow") as HTMLElement;
      if (h.dataset.key === sortKey) {
        h.dataset.dir = sortDir;
        arrow.textContent = sortDir === "asc" ? "↑" : "↓";
        arrow.classList.remove("opacity-50");
        arrow.classList.add("text-primary");
      } else {
        h.dataset.dir = "none";
        arrow.textContent = "↕";
        arrow.classList.add("opacity-50");
        arrow.classList.remove("text-primary");
      }
    });
  }

  headers.forEach((h) => {
    const activate = () => {
      const key = h.dataset.key as SortKey;
      if (sortKey === key) {
        sortDir = sortDir === "asc" ? "desc" : "asc";
      } else {
        sortKey = key;
        sortDir = "asc";
      }
      applySort();
    };
    h.addEventListener("click", activate);
    h.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        activate();
      }
    });
  });

  function applySearch() {
    const q = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    getRows().forEach((row) => {
      const tld = row.dataset.tld ?? "";
      const match = tld.includes(q);
      row.hidden = !match;
      if (match) visibleCount++;
    });

    noResultsEl.hidden = visibleCount !== 0;
    rowCountEl.textContent = q
      ? `${visibleCount} of ${getRows().length} TLDs`
      : `${getRows().length} TLDs`;
  }

  searchInput.addEventListener("input", applySearch);

  function renderPrices() {
    getRows().forEach((row) => {
      const reg = parseFloat(row.dataset.registration ?? "0");
      const ren = parseFloat(row.dataset.renewal ?? "0");

      const regCell = row.querySelector('[data-field="registration"]') as HTMLElement;
      const renCell = row.querySelector('[data-field="renewal"]') as HTMLElement;

      regCell.textContent = formatAmount(reg, currentCurrency, currentRates);
      renCell.textContent = formatAmount(ren, currentCurrency, currentRates);
    });
  }

  async function initCurrency() {
    if (currentCurrency !== "USD") {
      currentRates = await getRates();
    }
    renderPrices();
  }

  window.addEventListener("dp:currency-change", ((e: CustomEvent) => {
    currentCurrency = e.detail.currency;
    currentRates = e.detail.rates;
    renderPrices();
  }) as EventListener);

  applySort();
  applySearch();
  initCurrency();
</script>
